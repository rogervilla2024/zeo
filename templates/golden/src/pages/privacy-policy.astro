---
// Trust page stub. Run the generate-trust-pages skill to replace the
// placeholders from templates/pages/privacy-policy.md before launch.
import config from "../../site.config.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${config.site_name} handles visitor data.`}
  canonical={new URL("/privacy-policy/", config.domain).href}
  lang={config.default_language}
>
  <section class="prose">
    <h1>Privacy Policy</h1>
    <p>
      {"{{PRIVACY_BODY}}"} - fill this page from
      templates/pages/privacy-policy.md with the generate-trust-pages
      skill. Do not publish with placeholders left in.
    </p>
  </section>
</BaseLayout>
