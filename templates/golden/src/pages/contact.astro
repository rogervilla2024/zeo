---
// Trust page stub. Run the generate-trust-pages skill to replace the
// placeholders from templates/pages/contact.md before launch.
import config from "../../site.config.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description={`How to reach the ${config.site_name} team with questions, corrections, and feedback.`}
  canonical={new URL("/contact/", config.domain).href}
  lang={config.default_language}
>
  <section class="prose">
    <h1>Contact</h1>
    <p>
      Email us at
      <a href={`mailto:${config.legal.contact_email}`}>
        {config.legal.contact_email}
      </a>.
    </p>
    <p>
      {"{{RESPONSE_TIME}}"} - fill this page from
      templates/pages/contact.md with the generate-trust-pages skill.
    </p>
  </section>
</BaseLayout>
