---
// Trust page stub. Run the generate-trust-pages skill to replace the
// placeholders from templates/pages/disclaimer.md before launch.
import config from "../../site.config.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Disclaimer"
  description={`What ${config.site_name} content is and is not.`}
  canonical={new URL("/disclaimer", config.domain).href}
  lang={config.default_language}
>
  <a slot="header" href="/">{config.site_name}</a>
  <section class="prose">
    <h1>Disclaimer</h1>
    <p>
      {"{{NICHE_DISCLAIMER}}"} - fill this page from
      templates/pages/disclaimer.md with the generate-trust-pages skill.
      Do not publish with placeholders left in.
    </p>
  </section>
</BaseLayout>
