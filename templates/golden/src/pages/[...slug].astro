---
// Article template: two-column composition - the reading column
// (Breadcrumbs, h1, ArticleMeta, KeyTakeaways, TableOfContents, body,
// FaqAccordion, NewsletterCta) plus a sticky right sidebar with the
// in-cluster next reads. Article + BreadcrumbList (+ FAQPage) JSON-LD
// mirrors the visible content, as the toolkit's gates require.
import { getCollection, render } from "astro:content";
import config from "../../site.config.json";
import AdSlot from "../components/AdSlot.astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import KeyTakeaways from "../components/KeyTakeaways.astro";
import NewsletterCta from "../components/NewsletterCta.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const ui = config.ui ?? {};
const { post } = Astro.props;
const { Content, headings } = await render(post);

const canonical = new URL(`/${post.id}/`, config.domain).href;
const published = post.data.pubDate.toISOString();
const updated = (post.data.updatedDate ?? post.data.pubDate).toISOString();
// Full ISO datetimes go to the JSON-LD; the visible byline gets
// date-only strings (also valid for <time datetime>).
const publishedDate = published.slice(0, 10);
const updatedDate = updated.slice(0, 10);
const ogImage = post.data.image ?? config.seo.og_image;

const related = (await getCollection("blog"))
  .filter((other) => other.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((other) => ({
    title: other.data.title,
    url: `/${other.id}/`,
    description: other.data.description,
  }));

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  description: post.data.description,
  image: [new URL(ogImage, config.domain).href],
  author: {
    "@type": "Person",
    name: post.data.author,
    url: new URL(post.data.authorUrl, config.domain).href,
  },
  publisher: {
    "@type": "Organization",
    name: config.organization.name,
    logo: {
      "@type": "ImageObject",
      url: new URL(config.organization.logo, config.domain).href,
    },
  },
  datePublished: published,
  dateModified: updated,
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: ui.home ?? "Home",
      item: config.domain,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: ui.blog ?? "Blog",
      item: new URL("/blog/", config.domain).href,
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonical },
  ],
};
const faqSchema = post.data.faq.length
  ? [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: post.data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      },
    ]
  : [];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  lang={config.default_language}
  ogImage={ogImage}
  ogType="article"
  jsonLd={[article, breadcrumb, ...faqSchema]}
>
  <div class="with-aside">
  <article class="prose">
    <Breadcrumbs
      items={[
        { name: ui.home ?? "Home", url: "/" },
        { name: ui.blog ?? "Blog", url: "/blog/" },
        { name: post.data.title },
      ]}
    />
    <h1>{post.data.title}</h1>
    <ArticleMeta
      authorName={post.data.author}
      authorUrl={post.data.authorUrl}
      published={publishedDate}
      updated={updatedDate}
      words={post.body ? post.body.split(/\s+/).length : undefined}
      byLabel={ui.by}
      publishedLabel={ui.published}
      updatedLabel={ui.updated}
      minReadLabel={ui.min_read}
    />
    {post.data.takeaways.length > 0 && (
      <KeyTakeaways points={post.data.takeaways} title={ui.key_takeaways} />
    )}
    {headings.filter((h) => h.depth === 2).length >= 4 && (
      <TableOfContents
        title={ui.on_this_page}
        headings={headings
          .filter((h) => h.depth === 2)
          .map((h) => ({ slug: h.slug, text: h.text }))}
      />
    )}
    <Content />
    <AdSlot name="article-end" />
    {post.data.faq.length > 0 && <FaqAccordion items={post.data.faq} title={ui.faq_title} />}
    <NewsletterCta />
  </article>
  {related.length > 0 && (
    <Sidebar title={ui.read_next}>
      <ul>
        {related.map((other) => (
          <li><a href={other.url}>{other.title}</a></li>
        ))}
      </ul>
    </Sidebar>
  )}
  </div>
</BaseLayout>
