---
// Homepage: minimal-variant layout (intro plus a chronological post
// list) with the sitewide Organization and WebSite+SearchAction JSON-LD
// mirroring what scripts/build_jsonld.py produces.
import { getCollection } from "astro:content";
import config from "../../site.config.json";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.organization.name,
  url: config.domain,
  logo: new URL(config.organization.logo, config.domain).href,
  ...(config.organization.sameAs.length
    ? { sameAs: config.organization.sameAs }
    : {}),
};
// The template may be a path (recommended: "/search?q=...") or a full
// URL; paths resolve against the domain so they can never go stale.
const searchTemplate = config.seo.search_url_template.startsWith("http")
  ? config.seo.search_url_template
  : new URL(config.seo.search_url_template, config.domain).href;
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.site_name,
  url: config.domain,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: searchTemplate,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title={config.site_name}
  description={config.niche}
  canonical={new URL("/", config.domain).href}
  lang={config.default_language}
  jsonLd={[organization, website]}
>
  <Hero title={config.site_name} tagline={config.niche} />
  <section class="home-latest">
    <h2>Latest articles</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/${post.id}/`}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
