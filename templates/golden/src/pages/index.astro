---
// Homepage: portal-density composition - branding hero, a large
// feature card for the newest article, a thumbnail card grid for the
// rest, and a sticky popular rail. Sitewide Organization and
// WebSite+SearchAction JSON-LD mirror scripts/build_jsonld.py output.
import { getCollection } from "astro:content";
import config from "../../site.config.json";
import Hero from "../components/Hero.astro";
import Sidebar from "../components/Sidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const ui = config.ui ?? {};
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const popular = posts.slice(0, 5);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.organization.name,
  url: config.domain,
  logo: new URL(config.organization.logo, config.domain).href,
  ...(config.organization.sameAs.length
    ? { sameAs: config.organization.sameAs }
    : {}),
};
// The template may be a path (recommended: "/search?q=...") or a full
// URL; paths resolve against the domain so they can never go stale.
const searchTemplate = config.seo.search_url_template.startsWith("http")
  ? config.seo.search_url_template
  : new URL(config.seo.search_url_template, config.domain).href;
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.site_name,
  url: config.domain,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: searchTemplate,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title={config.site_name}
  description={config.niche}
  canonical={new URL("/", config.domain).href}
  lang={config.default_language}
  jsonLd={[organization, website]}
>
  <Hero title={config.site_name} tagline={config.niche} />
  <div class="with-aside">
    <section class="home-main">
      {featured && (
        <a class="feature-card" href={`/${featured.id}/`}>
          {featured.data.image && (
            <img
              src={featured.data.image}
              alt=""
              width="1600"
              height="900"
              fetchpriority="high"
            />
          )}
          <div class="feature-body">
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
          </div>
        </a>
      )}
      <h2 class="section-title">{ui.latest_articles ?? "Latest articles"}</h2>
      <ul class="post-list">
        {rest.map((post) => (
          <li>
            {post.data.image && (
              <img
                src={post.data.image}
                alt=""
                width="640"
                height="360"
                loading="lazy"
              />
            )}
            <a href={`/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
    {popular.length > 0 && (
      <Sidebar title={ui.popular ?? "Popular"}>
        <ul>
          {popular.map((post) => (
            <li><a href={`/${post.id}/`}>{post.data.title}</a></li>
          ))}
        </ul>
      </Sidebar>
    )}
  </div>
</BaseLayout>
