---
// Homepage: block-composed. config.site_type picks a DEFAULT block
// list (portal/product/directory/forum) and homepage.blocks
// overrides it - any subset, any order, any site_type:
//   lead zone (full width): quick_facts, how_to, directory,
//                           comparison
//   main zone (article column beside the sidebar): threads,
//                           feature, latest, strips
// Sitewide Organization and WebSite+SearchAction JSON-LD mirror
// scripts/build_jsonld.py output.
import { getCollection } from "astro:content";
import config from "../../site.config.json";
import EntityCard from "../components/EntityCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Hero from "../components/Hero.astro";
import HowToSteps from "../components/HowToSteps.astro";
import NewsletterCta from "../components/NewsletterCta.astro";
import PostCard from "../components/PostCard.astro";
import QuickFacts from "../components/QuickFacts.astro";
import Sidebar from "../components/Sidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { slugify } from "../lib/slugify";

const ui = config.ui ?? {};
const siteType: string = config.site_type ?? "portal";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
// Product and directory homepages lead with their own blocks, so
// the article section shrinks to a supporting role.
const latest = rest.slice(0, siteType === "portal" ? 6 : 3);
const popular = posts.slice(0, 5);
const isForum = siteType === "forum";
const answersLabel = (count: number) =>
  (ui.answers_count ?? "{count} answers").replace("{count}", String(count));

// Archetypes are defaults, not cages: homepage.blocks reorders,
// drops, or MIXES every homepage section on any site_type - a hotel
// portal can pull in the directory block, a product site can drop
// how_to, a forum can lead with quick_facts. Unknown ids are
// ignored; an empty list means the archetype's default. Blocks
// render in list order within their zone: lead blocks span the full
// width above the fold, main blocks sit in the article column next
// to the sidebar. With 8 orderable blocks the composition space is
// in the thousands before recipes, variants, or palettes even move.
interface CtaBanner {
  text?: string;
  label?: string;
  url?: string;
  sponsored?: boolean;
}
interface FaqItem {
  question: string;
  answer: string;
}
interface HomepageConfig {
  blocks: string[];
  hero_stats?: boolean;
  cta_banner?: CtaBanner;
  faq?: FaqItem[];
  hero?: string;
  hero_image?: string;
  aside?: string;
  rail?: string;
}
const homepage: HomepageConfig = config.homepage ?? { blocks: [] };

// Page ANATOMY: what the first screen does and where the rail sits.
// The topic decides this the way it separates a booking funnel from
// a feed board from a marketplace (recipes.md, "Page anatomies"):
//   homepage.hero:  "standard" (branding block) | "search" (the
//                   search box IS the hero) | "compact" (slim strip,
//                   content leads) | "none" (straight into blocks;
//                   the h1 stays for SEO, visually hidden)
//   homepage.aside: "right" | "left" | "none"
const HERO_MODES = [
  "standard", "search", "compact", "none", "cover", "signup",
];
const heroMode = HERO_MODES.includes(homepage.hero ?? "")
  ? (homepage.hero as string)
  : "standard";
const ASIDE_MODES = ["right", "left", "none"];
// What the rail holds: reader favorites, the topic map, the
// directory's filters (booking-style left filter rail with
// aside: "left"), or the newsletter box.
const RAIL_MODES = ["popular", "categories", "facets", "newsletter"];
const railMode = RAIL_MODES.includes(homepage.rail ?? "")
  ? (homepage.rail as string)
  : "popular";
const asideMode = ASIDE_MODES.includes(homepage.aside ?? "")
  ? (homepage.aside as string)
  : "right";
// Filter-rail fallback: when every active block lives in the lead
// zone (e.g. a directory list) and a rail is requested, the rail
// docks BESIDE the lead content instead of dangling under an empty
// main column - the booking results-page anatomy.
// A block id may carry a view modifier after a colon - the same
// block, composed differently: "directory:list" renders the catalog
// as booking rows, "feature:overlay" puts the title on the image,
// "feature:split" halves the card, "latest:rows" is a dense digest.
const blockBase = (block: string) => block.split(":")[0];
const blockStyle = (block: string) => block.split(":")[1] ?? "";
const LEAD_BLOCK_IDS = [
  "quick_facts",
  "how_to",
  "directory",
  "comparison",
  "cta_banner",
  "ticker",
];
const MAIN_BLOCK_IDS = ["threads", "feed", "feature", "latest",
  "strips", "newsletter", "faq"];
const blockDefaults =
  siteType === "product"
    ? ["quick_facts", "how_to", "feature", "latest"]
    : siteType === "directory"
      ? ["directory", "comparison", "feature", "latest"]
      : isForum
        ? ["threads"]
        : ["feature", "latest", "strips"];
const activeBlocks = homepage.blocks.length ? homepage.blocks : blockDefaults;
const leadBlocks = activeBlocks.filter((block) =>
  LEAD_BLOCK_IDS.includes(blockBase(block)),
);
const mainBlocks = activeBlocks.filter((block) =>
  MAIN_BLOCK_IDS.includes(blockBase(block)),
);
const leadIds = leadBlocks.map(blockBase);
const mainIds = mainBlocks.map(blockBase);
const railBesideLead =
  asideMode !== "none" && mainBlocks.length === 0 && leadBlocks.length > 0;
// Directory data powers both the card grid and the comparison table.
const wantsDirectory =
  leadIds.includes("directory") || leadIds.includes("comparison");

// The threads board: question rows with answer counts, newest first.
const threads = mainIds.includes("threads") ? posts.slice(0, 12) : [];

// The feed: a single-column stream of every recent post, board-style
// (thumb, chip, title, summary, date) - the community/news anatomy.
const feedPosts = mainIds.includes("feed") ? posts.slice(0, 20) : [];

// The ticker: a one-line scrolling strip of the freshest headlines
// (newsroom chrome), and the rail's category map with counts.
const tickerPosts = leadIds.includes("ticker") ? posts.slice(0, 8) : [];
const railCategories = new Map<string, number>();
if (railMode === "categories") {
  for (const post of posts) {
    if (!post.data.category) continue;
    railCategories.set(
      post.data.category,
      (railCategories.get(post.data.category) ?? 0) + 1,
    );
  }
}

// One strip per pillar/category (strips block), biggest clusters
// first, three most recent articles each; titles link to the
// category archives.
const categoryBase = config.seo.category_base ?? "category";
const byCategory = new Map<string, typeof posts>();
if (mainIds.includes("strips")) {
  for (const post of posts) {
    const category = post.data.category;
    if (!category) continue;
    const bucket = byCategory.get(category) ?? [];
    bucket.push(post);
    byCategory.set(category, bucket);
  }
}
const strips = [...byCategory.entries()]
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 4)
  .map(([name, list]) => ({
    name,
    url: `/${categoryBase}/${slugify(name)}/`,
    posts: list.slice(0, 3),
  }));

// Product data from the config; empty sections simply do not render.
interface ProductConfig {
  name?: string;
  cta_label?: string;
  demo_path?: string;
  facts: { label: string; value: string }[];
  steps: { title: string; text: string }[];
}
const product: ProductConfig = config.product ?? { facts: [], steps: [] };

const heroCta =
  siteType === "product" && product.cta_label
    ? {
        ctaLabel: product.cta_label,
        ctaHref: product.demo_path || (featured ? `/${featured.id}/` : "/blog/"),
      }
    : {};

// Directory data from the entities collection; each card links to
// the entity's in-depth article.
const entities =
  wantsDirectory
    ? (await getCollection("entities")).sort(
        (a, b) =>
          a.data.order - b.data.order ||
          a.data.title.localeCompare(b.data.title),
      )
    : [];
const comparisonLabels =
  entities[0]?.data.attributes.map((attr) => attr.label) ?? [];

// Facet chips: one link per attribute value of each configured
// facet, pointing at its pre-rendered archive - the zero-JS answer
// to filtering.
interface DirectoryConfig {
  base?: string;
  facets: string[];
}
const directoryConfig: DirectoryConfig = config.directory ?? { facets: [] };
const directoryBase = directoryConfig.base || "directory";
const facetLinks =
  wantsDirectory
    ? directoryConfig.facets.flatMap((label) => {
        const facetSlug = slugify(label);
        const values = new Map<string, string>();
        for (const entity of entities) {
          const match = entity.data.attributes.find(
            (attr) => attr.label === label,
          );
          if (match && !values.has(slugify(match.value))) {
            values.set(slugify(match.value), match.value);
          }
        }
        return [...values.entries()]
          .filter(([slug]) => facetSlug && slug)
          .map(([slug, value]) => ({
            label: value,
            url: `/${directoryBase}/${facetSlug}/${slug}/`,
          }));
      })
    : [];

// Booking-style grouping: past a dozen entities a flat grid stops
// working - group by the first facet's values, capped per group,
// each heading linking to its full archive.
const GROUP_LIMIT = 12;
const firstFacet = directoryConfig.facets[0];
const groupsMap = new Map<string, typeof entities>();
if (wantsDirectory && entities.length > GROUP_LIMIT && firstFacet) {
  for (const entity of entities) {
    const match = entity.data.attributes.find(
      (attr) => attr.label === firstFacet,
    );
    if (!match) continue;
    const bucket = groupsMap.get(match.value) ?? [];
    bucket.push(entity);
    groupsMap.set(match.value, bucket);
  }
}
const groups = [...groupsMap.entries()].map(([value, list]) => ({
  value,
  url: `/${directoryBase}/${slugify(firstFacet ?? "")}/${slugify(value)}/`,
  entities: list.slice(0, 6),
}));

// Hero stat line (homepage.hero_stats): real counts from the build -
// entities, distinct first-facet values, and articles - rendered as
// "128 hotels / 6 regions / 42 guides". Nouns come from
// config.ui so every site states its own inventory; a count of zero
// simply drops its segment. Never hand-write numbers into the hero:
// this line can never go stale, a hardcoded one always does.
const statLine = (template: string | undefined, count: number) =>
  (template ?? "{count}").replace("{count}", String(count));
const firstFacetValues = new Set(
  entities
    .map(
      (entity) =>
        entity.data.attributes.find((attr) => attr.label === firstFacet)
          ?.value,
    )
    .filter(Boolean),
);
// Functional blocks: campaign banner (external offer links declare
// themselves sponsored unless explicitly opted out), homepage FAQ
// (visible answers mirrored 1:1 in FAQPage JSON-LD - never one
// without the other), and the newsletter box (renders only when
// config.newsletter.enabled is true).
const ctaBanner: CtaBanner = homepage.cta_banner ?? {};
const bannerReady = Boolean(ctaBanner.text && ctaBanner.label && ctaBanner.url);
const bannerRel =
  ctaBanner.url?.startsWith("http") && ctaBanner.sponsored !== false
    ? "sponsored nofollow noopener"
    : undefined;
const homepageFaq: FaqItem[] = (homepage.faq ?? []).filter(
  (item) => item.question && item.answer,
);
const faqJsonLd =
  mainIds.includes("faq") && homepageFaq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: homepageFaq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;

// Category color coding: theme.category_colors maps a category name
// to its accent; strips and the category archive heading pick it up
// as --category-color (fallback: the primary color).
const categoryColors: Record<string, string> =
  config.theme?.category_colors ?? {};
const catStyle = (name?: string) =>
  name && categoryColors[name]
    ? `--category-color: ${categoryColors[name]}`
    : undefined;

const heroStats: string[] = [];
if (homepage.hero_stats) {
  if (entities.length > 0) {
    heroStats.push(statLine(ui.stat_entities, entities.length));
  }
  if (firstFacetValues.size > 0) {
    heroStats.push(statLine(ui.stat_facet_values, firstFacetValues.size));
  }
  if (posts.length > 0) {
    heroStats.push(statLine(ui.stat_articles, posts.length));
  }
}

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.organization.name,
  url: config.domain,
  logo: new URL(config.organization.logo, config.domain).href,
  ...(config.organization.sameAs.length
    ? { sameAs: config.organization.sameAs }
    : {}),
};
// The template may be a path (recommended: "/search?q=...") or a full
// URL; paths resolve against the domain so they can never go stale.
const searchTemplate = config.seo.search_url_template.startsWith("http")
  ? config.seo.search_url_template
  : new URL(config.seo.search_url_template, config.domain).href;
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.site_name,
  url: config.domain,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: searchTemplate,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title={config.site_name}
  description={config.niche}
  canonical={new URL("/", config.domain).href}
  lang={config.default_language}
  jsonLd={[organization, website, ...(faqJsonLd ? [faqJsonLd] : [])]}
>
  {heroMode === "none" ? (
    <h1 class="visually-hidden">{config.site_name}</h1>
  ) : (
    <Hero
      title={config.site_name}
      tagline={config.niche}
      mode={heroMode}
      image={homepage.hero_image}
      {...heroCta}
    >
      {heroStats.length > 0 && (
        <p class="hero-stats">{heroStats.join(" \u00B7 ")}</p>
      )}
      {heroMode === "signup" && (
        <NewsletterCta
          title={ui.newsletter_title}
          description={ui.newsletter_text}
          buttonLabel={ui.newsletter_button}
        />
      )}
      {(heroMode === "search" ||
        leadIds.includes("directory") ||
        mainIds.includes("threads")) && (
        <form class="hero-search" action="/search" method="get">
          <input
            type="search"
            name="q"
            placeholder={ui.search_placeholder ?? "Search this site"}
            aria-label={ui.search ?? "Search"}
          />
          <button type="submit">{ui.search ?? "Search"}</button>
        </form>
      )}
    </Hero>
  )}
  <div
    class:list={[
      railBesideLead && "rail-beside",
      railBesideLead && asideMode === "left" && "left",
    ]}
  >
  {leadBlocks.map((block) => (
    <>
      {blockBase(block) === "quick_facts" && product.facts.length > 0 && (
        <QuickFacts title={ui.quick_facts} facts={product.facts} />
      )}
      {blockBase(block) === "how_to" && product.steps.length > 0 && (
        <HowToSteps title={ui.how_to_title} steps={product.steps} />
      )}
      {blockBase(block) === "directory" && entities.length > 0 && (
    <section class="directory">
      <h2 class="section-title">{ui.directory_title ?? "Browse the directory"}</h2>
      {facetLinks.length > 0 && (
        <ul class="facet-nav">
          {facetLinks.map((link) => (
            <li><a href={link.url}>{link.label}</a></li>
          ))}
        </ul>
      )}
      {groups.length > 0 ? (
        groups.map((group) => (
          <section class="entity-group">
            <h2 class="section-title">
              <a href={group.url}>{group.value}</a>
              <a class="view-all" href={group.url}>{ui.view_all ?? "View all"}</a>
            </h2>
            <ul
              class:list={[
                "entity-grid",
                blockStyle(block) === "list" && "entity-grid--list",
                blockStyle(block) === "shelves" && "entity-grid--shelves",
                blockStyle(block) === "index" && "entity-grid--index",
              ]}
            >
              {group.entities.map((entity) => (
                <EntityCard
                  title={entity.data.title}
                  url={entity.data.article}
                  description={entity.data.description}
                  image={entity.data.image ?? entity.data.images[0]}
                  badge={entity.data.badge}
                  price={entity.data.price}
                  rating={entity.data.rating}
                  scoreLabel={ui.editor_score}
                  ctaUrl={entity.data.cta_url}
                  ctaLabel={ui.entity_cta}
                  hideAttribute={firstFacet}
                  attributes={entity.data.attributes}
                />
              ))}
            </ul>
          </section>
        ))
      ) : (
        <ul
          class:list={[
            "entity-grid",
            blockStyle(block) === "list" && "entity-grid--list",
            blockStyle(block) === "shelves" && "entity-grid--shelves",
            blockStyle(block) === "index" && "entity-grid--index",
          ]}
        >
          {entities.map((entity) => (
            <EntityCard
              title={entity.data.title}
              url={entity.data.article}
              description={entity.data.description}
              image={entity.data.image ?? entity.data.images[0]}
              badge={entity.data.badge}
              price={entity.data.price}
              rating={entity.data.rating}
              scoreLabel={ui.editor_score}
              ctaUrl={entity.data.cta_url}
              ctaLabel={ui.entity_cta}
              attributes={entity.data.attributes}
            />
          ))}
        </ul>
      )}
    </section>
      )}
      {blockBase(block) === "ticker" && tickerPosts.length > 0 && (
        <div class="ticker">
          <span class="ticker-label">{ui.ticker_label ?? "Latest"}</span>
          <ul>
            {tickerPosts.map((post) => (
              <li><a href={`/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
      {blockBase(block) === "cta_banner" && bannerReady && (
        <aside class="cta-banner">
          <p>{ctaBanner.text}</p>
          <a href={ctaBanner.url} rel={bannerRel}>{ctaBanner.label}</a>
        </aside>
      )}
      {blockBase(block) === "comparison" &&
        groups.length === 0 &&
        comparisonLabels.length > 0 && (
        <div class="comparison">
          <table>
            <thead>
              <tr>
                <th>{ui.comparison_title ?? "Compare"}</th>
                {comparisonLabels.map((label) => <th>{label}</th>)}
              </tr>
            </thead>
            <tbody>
              {entities.map((entity) => (
                <tr>
                  <td>
                    {entity.data.article ? (
                      <a href={entity.data.article}>{entity.data.title}</a>
                    ) : (
                      entity.data.title
                    )}
                  </td>
                  {comparisonLabels.map((label) => (
                    <td>
                      {entity.data.attributes.find(
                        (attr) => attr.label === label,
                      )?.value ?? "-"}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  ))}
  <div
    class:list={[
      asideMode !== "none" && "with-aside",
      asideMode === "left" && "left",
    ]}
  >
    <section class="home-main">
      {mainBlocks.map((block) => (
        <>
          {blockBase(block) === "threads" && threads.length > 0 && (
            <>
              <h2 class="section-title">
                {ui.latest_articles ?? "Latest threads"}
              </h2>
              <ol class="thread-list">
                {threads.map((post) => (
                  <li>
                    <a href={`/${post.id}/`}>{post.data.title}</a>
                    <p class="thread-meta">
                      {post.data.category && (
                        <span class="thread-tag">{post.data.category}</span>
                      )}
                      <span>{answersLabel(post.data.replies.length)}</span>
                      <time
                        datetime={post.data.pubDate.toISOString().slice(0, 10)}
                      >
                        {post.data.pubDate.toISOString().slice(0, 10)}
                      </time>
                    </p>
                  </li>
                ))}
              </ol>
            </>
          )}
          {blockBase(block) === "feed" && feedPosts.length > 0 && (
            <ol
              class:list={[
                "feed",
                blockStyle(block) === "compact" && "feed--compact",
              ]}
            >
              {feedPosts.map((post) => (
                <li class="feed-item">
                  {post.data.image && (
                    <img
                      src={post.data.image}
                      alt=""
                      width="640"
                      height="360"
                      loading="lazy"
                    />
                  )}
                  <div class="feed-body">
                    {post.data.category && (
                      <span
                        class="post-category"
                        style={catStyle(post.data.category)}
                      >{post.data.category}</span>
                    )}
                    <a href={`/${post.id}/`}>{post.data.title}</a>
                    <p>{post.data.description}</p>
                    <p class="feed-meta">
                      <time
                        datetime={post.data.pubDate.toISOString().slice(0, 10)}
                      >
                        {post.data.pubDate.toISOString().slice(0, 10)}
                      </time>
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          )}
          {blockBase(block) === "feature" && featured && (
            <a
              class:list={[
                "feature-card",
                blockStyle(block) === "overlay" && "feature-card--overlay",
                blockStyle(block) === "split" && "feature-card--split",
              ]}
              href={`/${featured.id}/`}
            >
              {featured.data.image && (
                <img
                  src={featured.data.image}
                  alt=""
                  width="1600"
                  height="900"
                  fetchpriority="high"
                />
              )}
              <div class="feature-body">
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
              </div>
            </a>
          )}
          {blockBase(block) === "latest" && latest.length > 0 && (
            <>
              <h2 class="section-title">
                {ui.latest_articles ?? "Latest articles"}
              </h2>
              <ul
                class:list={[
                  "post-list",
                  blockStyle(block) === "rows" && "post-list--rows",
                  blockStyle(block) === "tiles" && "post-list--tiles",
                ]}
              >
                {latest.map((post) => (
                  <PostCard
                    title={post.data.title}
                    url={`/${post.id}/`}
                    description={post.data.description}
                    image={post.data.image}
                    category={post.data.category}
                    categoryStyle={catStyle(post.data.category)}
                  />
                ))}
              </ul>
            </>
          )}
          {blockBase(block) === "newsletter" && (
            <NewsletterCta
              title={ui.newsletter_title}
              description={ui.newsletter_text}
              buttonLabel={ui.newsletter_button}
            />
          )}
          {blockBase(block) === "faq" && homepageFaq.length > 0 && (
            <FaqAccordion items={homepageFaq} title={ui.faq_title} />
          )}
          {blockBase(block) === "strips" &&
            strips.map((strip) => (
              <section class="category-strip" style={catStyle(strip.name)}>
                <h2 class="section-title">
                  <a href={strip.url}>{strip.name}</a>
                </h2>
                <ul class="post-list">
                  {strip.posts.map((post) => (
                    <PostCard
                      title={post.data.title}
                      url={`/${post.id}/`}
                      description={post.data.description}
                      image={post.data.image}
                      category={post.data.category}
                      categoryStyle={catStyle(post.data.category)}
                    />
                  ))}
                </ul>
              </section>
            ))}
        </>
      ))}
    </section>
    {asideMode !== "none" && railMode === "popular" && popular.length > 0 && (
      <Sidebar title={ui.popular ?? "Popular"}>
        <ul>
          {popular.map((post) => (
            <li><a href={`/${post.id}/`}>{post.data.title}</a></li>
          ))}
        </ul>
      </Sidebar>
    )}
    {asideMode !== "none" && railMode === "categories" &&
      railCategories.size > 0 && (
      <Sidebar title={ui.rail_categories ?? "Topics"}>
        <ul>
          {[...railCategories.entries()]
            .sort((a, b) => b[1] - a[1])
            .map(([name, count]) => (
              <li>
                <a href={`/${categoryBase}/${slugify(name)}/`}>
                  {name}
                </a>{" "}
                <span class="rail-count">{count}</span>
              </li>
            ))}
        </ul>
      </Sidebar>
    )}
    {asideMode !== "none" && railMode === "facets" &&
      facetLinks.length > 0 && (
      <Sidebar title={ui.directory_title ?? "Browse the directory"}>
        <ul>
          {facetLinks.map((link) => (
            <li><a href={link.url}>{link.label}</a></li>
          ))}
        </ul>
      </Sidebar>
    )}
    {asideMode !== "none" && railMode === "newsletter" && (
      <aside class="site-aside">
        <NewsletterCta
          title={ui.newsletter_title}
          description={ui.newsletter_text}
          buttonLabel={ui.newsletter_button}
        />
      </aside>
    )}
  </div>
  </div>
</BaseLayout>
