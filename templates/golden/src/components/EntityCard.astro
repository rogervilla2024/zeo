---
// Directory entity card: one catalog item (a hotel, a tool, a
// venue) with its key attributes. Data comes from the entities
// content collection; the card links to the entity's in-depth
// review article, keeping articles the single deep-dive format.
interface Attribute {
  label: string;
  value: string;
}
interface Props {
  title: string;
  url?: string;
  description?: string;
  image?: string;
  badge?: string;
  price?: string;
  rating?: string;
  scoreLabel?: string;
  ctaUrl?: string;
  ctaLabel?: string;
  // When the card sits inside a section already grouped by this
  // attribute (e.g. a "Coast" region group), hide its row -
  // repeating the group heading on every card is noise.
  hideAttribute?: string;
  attributes?: Attribute[];
}
const {
  title,
  url,
  description,
  image,
  badge,
  price,
  rating,
  scoreLabel = "Editor's score",
  ctaUrl,
  ctaLabel = "See prices",
  hideAttribute,
  attributes = [],
} = Astro.props;
const visibleAttributes = attributes.filter(
  (attr) => attr.label !== hideAttribute,
);
---

<li class="entity-card">
  {image && (
    <img src={image} alt="" width="640" height="360" loading="lazy" />
  )}
  {badge && <span class="entity-badge">{badge}</span>}
  {url ? (
    <a href={url}>{title}</a>
  ) : (
    <span class="entity-title">{title}</span>
  )}
  {description && <p>{description}</p>}
  {rating && (
    <p class="entity-score"><span>{scoreLabel}</span> {rating}</p>
  )}
  {price && <p class="entity-price">{price}</p>}
  {visibleAttributes.length > 0 && (
    <ul class="entity-attrs">
      {visibleAttributes.map((attr) => (
        <li>
          <span>{attr.label}</span> {attr.value}
        </li>
      ))}
    </ul>
  )}
  {ctaUrl && (
    <a
      class="entity-cta"
      href={ctaUrl}
      rel="sponsored nofollow noopener"
    >
      {ctaLabel}
    </a>
  )}
</li>
