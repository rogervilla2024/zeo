---
// Visible author box for article ends: photo, linked name, role, and
// a one-line bio, pointing at the /authors/ profile page. E-E-A-T
// requires the schema to mirror visible content - this box is the
// visible counterpart of the Article JSON-LD's author node, so keep
// the name and URL identical to the frontmatter byline.
interface Props {
  name: string;
  url: string;
  role?: string;
  bio?: string;
  image?: string;
  title?: string;
}
const {
  name,
  url,
  role,
  bio,
  image,
  title = "About the author",
} = Astro.props;
---

<aside class="author-box">
  <p class="author-box-title">{title}</p>
  <div class="author-box-body">
    {image && (
      <img src={image} alt={name} width="72" height="72" loading="lazy" />
    )}
    <div>
      <p class="author-box-name"><a href={url}>{name}</a></p>
      {role && <p class="author-box-role">{role}</p>}
      {bio && <p class="author-box-bio">{bio}</p>}
    </div>
  </div>
</aside>
