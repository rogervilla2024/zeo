# Cloudflare Pages headers file. Copy into the site's public/ directory
# so it ships at the root of the build output (dist/_headers).
# Immutable caching for hashed build assets; sane security defaults
# everywhere. Adjust paths to the framework's asset directory.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# RFC 9727 well-known API catalog has no file extension; pin its type.
/.well-known/api-catalog
  Content-Type: application/linkset+json

# RFC 8288 Link headers on the homepage: agents discover the machine
# endpoints (API catalog, llms.txt, feed) without parsing HTML.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </rss.xml>; rel="alternate"; type="application/rss+xml"

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
