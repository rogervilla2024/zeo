---
// Sidebar container for two-column compositions. Wrap a page's main
// content and this aside in a `.with-aside` (or `.with-aside.left`)
// grid - the utility ships in tokens.css - and fill the slot with
// whatever the site's composition calls for: cluster navigation,
// recent posts, category links. Collapses under the content on
// narrow viewports. Zero JavaScript.
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="site-aside">
  {title && <h2 class="site-aside-title">{title}</h2>}
  <slot />
</aside>
